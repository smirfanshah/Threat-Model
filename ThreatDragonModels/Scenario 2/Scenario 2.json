                {
                  "id": "0ad54b06-9740-48a6-8de1-e47b9c8bb4a8",
                  "title": "Unauthorized Access to Transaction Database",
                  "status": "Open",
                  "severity": "High",
                  "type": "",
                  "description": "The frontend or email dispatcher shouldn't need direct database access — only the backend server should read/write transactions. If database credentials are broadly shared across services, a compromised frontend (e.g., via XSS or injected dependency) could directly query the Transaction Database, exposing all customer payment records.",
                  "mitigation": "Apply strict least-privilege DB access — the backend server gets read/write on transactions, frontend gets nothing, email dispatcher gets read-only on order details only. Use separate DB credentials per service and enforce at the network level with firewall rules restricting DB port access to backend server IP only.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                }
              ],
