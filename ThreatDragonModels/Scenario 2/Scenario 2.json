              "threats": [
                {
                  "id": "df3ce5bd-88c8-4f44-9ae1-f60f393d758a",
                  "title": "transaction Result Manipulation in Transit",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "The payment gateway sends a transaction result (success/failure + amount) back to the backend. If an attacker is positioned as a MITM, they could modify the response — flipping a failed transaction to success, or changing the amount. The backend then stores the tampered result in the Transaction Database and ships the order.",
                  "mitigation": "Use HMAC or digital signature verification on payment gateway responses — most gateways (Stripe, PayPal) provide webhook signatures. The backend must verify this signature before trusting any result. TLS alone isn't enough if the application layer doesn't validate integrity.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "5cff9924-373d-4ceb-8764-e624be44a994",
                  "title": "Payment Endpoint Flooding",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "An attacker floods the backend's payment processing endpoint with a high volume of requests. Even if transactions fail at the gateway level, the backend still processes each request — consuming CPU, DB connections, and potentially exhausting the API rate limit quota on the payment gateway, making legitimate transactions impossible.",
                  "mitigation": "Implement rate limiting per user/IP on the payment endpoint. Add a request queue to decouple frontend load from backend processing. Set up circuit breakers to stop forwarding requests to the gateway when a threshold is hit, protecting both your system and the third-party quota.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                }
              ],
              "trustBoundaryIds": [
                "2eaa0ddd-a1c9-43ce-844a-77c9b43df7de"
              ],
              "threatFrequency": {
                "tampering": 1,
                "informationDisclosure": 0,
                "denialOfService": 1
              }
            },
