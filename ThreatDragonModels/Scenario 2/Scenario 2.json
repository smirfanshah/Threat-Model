              "type": "tm.Flow",
              "name": "REST API call + API key ",
              "description": "",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isBidirectional": false,
              "isEncrypted": false,
              "isPublicNetwork": false,
              "protocol": "",
              "threats": [
                {
                  "id": "030890d0-0955-43ae-b6a9-4f1549aba38c",
                  "title": "Payment Gateway Impersonation",
                  "status": "Open",
                  "severity": "High",
                  "type": "",
                  "description": " An attacker intercepts or poisons DNS to redirect the backend's REST API calls to a fake payment gateway. Since the backend authenticates to the gateway using an API key but may not strictly verify the gateway's identity (certificate pinning absent), it could be talking to a malicious server that harvests card data and returns fake success responses.",
                  "mitigation": "Enforce TLS certificate validation on all outbound API calls — never disable SSL verification. Implement certificate pinning for the payment gateway endpoint. This ensures the backend only talks to the legitimate gateway even under DNS spoofing.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "7a67472c-08c2-421d-a7d5-4b6dbe916efa",
                  "title": "API Key Exposure in Transit or Logs",
                  "status": "Open",
                  "severity": "TBD",
                  "type": "Information disclosure",
                  "description": "The backend authenticates to the payment gateway using an API key embedded in REST API calls. If the key appears in application logs, error messages, or is transmitted without proper header handling (e.g., accidentally logged in plaintext), an attacker with log access can steal the key and make unauthorized payment requests directly to the gateway.",
                  "mitigation": "Store API keys in environment variables or a secrets manager (e.g., AWS Secrets Manager, HashiCorp Vault) — never hardcode. Ensure logging middleware masks sensitive headers like Authorization. Rotate keys regularly and restrict key permissions to minimum required operations.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "cd7448d6-00dc-43c3-a89c-31910e1c64ae",
                  "title": "New STRIDE threat",
                  "status": "Open",
                  "severity": "TBD",
                  "type": "Tampering",
                  "description": "Provide a description for this threat",
                  "mitigation": "Provide remediation for this threat or a reason if status is N/A",
                  "modelType": "STRIDE",
                  "new": true,
                  "number": 9,
                  "score": ""
                },
                {
                  "id": "0ee597b8-0517-48d8-8bf3-c4b47d3b6ca5",
                  "title": "Trust Boundary Violation",
                  "status": "Open",
                  "severity": "TBD",
                  "type": "Tampering",
                  "description": "The data flow carrying the REST API call (including the API key) crosses from your Internal Platform Zone directly into the Payment Gateway Zone — a third-party boundary you don't control.\nSecurity implications:\n\nYou lose control of the data once it crosses. The payment gateway could log your request payload, including sensitive fields, in ways you can't audit or control.\nThe API key travels across this boundary on every request. If the connection is misconfigured even once (e.g., TLS disabled in a dev environment that bleeds into prod), the key is exposed externally.\nThe gateway's availability directly affects your system. If the gateway goes down or rate-limits you, your entire checkout flow breaks — a dependency risk introduced by this boundary crossing.\nResponse integrity isn't guaranteed. Data flowing back across this boundary (transaction results) comes from an external party — your system must never blindly trust it without signature verification.\n\n",
                  "mitigation": "Provide remediation for this threat or a reason if status is N/A",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 10,
                  "score": ""
                }
              ],
