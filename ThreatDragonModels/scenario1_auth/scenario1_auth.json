              "threats": [
                {
                  "id": "5a2b2d41-91e6-47ae-aff6-a0625a5b0a4f",
                  "title": "Session Token Manipulation",
                  "status": "Open",
                  "severity": "TBD",
                  "type": "",
                  "description": "If session tokens are predictable or weakly generated, an attacker can modify a token value to hijack another user's session. The data flow between Web Server and Session Manager is the attack surface.\n",
                  "mitigation": "Use cryptographically secure random token generation (e.g., secrets.token_hex(32)). Bind tokens to IP/user-agent. Set short expiry times.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                }
              ],
