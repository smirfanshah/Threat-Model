              "threats": [
                {
                  "id": "dbd65656-5448-4421-b153-49a6bb2ae06e",
                  "title": "Credential Brute Force Attack",
                  "status": "Open",
                  "severity": "TBD",
                  "type": "",
                  "description": "An attacker systematically tries username/password combinations against the login endpoint. Since there's no MFA and no account lockout mentioned, so then there's nothing which stops automated guessing tools like Hydra or Burp Intruder.",
                  "mitigation": "Implement account lockout or rate limiting after N failed attempts (e.g., 5 tries leading to 15 min lockout). Add CAPTCHA for repeated failures. MFA would eliminate this risk almost entirely.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                }
